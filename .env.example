# Amahoro Luxury Villa — environment variables
#
# Copy this file to `.env` for local development. In production every variable
# is set in the Vercel project (Settings → Environment Variables), never committed.
# Every variable the code reads is listed here; see HANDOVER.md for where each
# value comes from.

# ---------------------------------------------------------------------------
# Database (Neon Postgres, via Prisma)
# ---------------------------------------------------------------------------
# Pooled connection string, used by the app at runtime (prisma/schema.prisma `url`).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string, used by Prisma for migrations / db push
# (prisma/schema.prisma `directUrl`).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL, used to build payment redirect URLs and links in emails.
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (Resend — https://resend.com)
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY the app logs emails to the console instead of sending.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Receives admin copies of booking and payment notifications.
ADMIN_EMAIL=admin@amahoroluxuryvilla.com
# Sender shown to guests. The domain must be verified in the Resend account.
FROM_EMAIL="Amahoro Luxury Villa <bookings@amahoroluxuryvilla.com>"

# ---------------------------------------------------------------------------
# Image uploads (Cloudinary — admin gallery upload, src/lib/cloudinary.ts)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Payments — DPO Pay (the gateway the code currently calls, src/lib/dpo.ts)
# ---------------------------------------------------------------------------
# DPO_ENVIRONMENT: "live" for production, anything else uses the DPO sandbox.
DPO_ENVIRONMENT=sandbox
DPO_COMPANY_TOKEN=YOUR_COMPANY_TOKEN
DPO_SERVICE_TYPE=YOUR_SERVICE_TYPE

# ---------------------------------------------------------------------------
# Payments — Flutterwave (keys present on the Vercel project; the current code
# does not read them. Kept here so the production configuration is documented.
# See HANDOVER.md → "Payments" before changing anything.)
# ---------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
