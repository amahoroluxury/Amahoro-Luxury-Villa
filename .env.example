# Database (Use PostgreSQL for Vercel deployment)
# DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Flutterwave Payment Integration
# Get your keys from https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook verification hash (set this in Flutterwave dashboard under Webhooks)
FLUTTERWAVE_WEBHOOK_HASH=your-custom-webhook-hash-here

# Site Configuration
SITE_URL=http://localhost:3000

# Email Configuration (using Resend - https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin@amahoroluxury.com
